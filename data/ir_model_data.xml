<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- base.automation: Comments / Status are declared in models/base_automation.py -->
        <!-- ============================================================
             ir.rule
             ============================================================ -->
        <record id="field_ir_rule_x_studio_description" model="ir.model.fields">
            <field name="name">x_studio_description</field>
            <field name="model">ir.rule</field>
            <field name="model_id" ref="base.model_ir_rule"/>
            <field name="ttype">text</field>
            <field name="field_description">Description</field>
            <field name="state">manual</field>
            <field name="store" eval="True"/>
            <field name="copied" eval="True"/>
        </record>
        <!-- ============================================================
             ir.model.access
             ============================================================ -->
        <record id="field_ir_model_access_x_studio_user_name" model="ir.model.fields">
            <field name="name">x_studio_user_name</field>
            <field name="model">ir.model.access</field>
            <field name="model_id" ref="base.model_ir_model_access"/>
            <field name="ttype">char</field>
            <field name="field_description">User Name</field>
            <field name="state">manual</field>
            <field name="readonly" eval="True"/>
            <field name="store" eval="True"/>
        </record>
        <record id="field_ir_model_access_x_studio_number_of_users" model="ir.model.fields">
            <field name="name">x_studio_number_of_users</field>
            <field name="model">ir.model.access</field>
            <field name="model_id" ref="base.model_ir_model_access"/>
            <field name="ttype">many2many</field>
            <field name="field_description">Users</field>
            <field name="relation">res.users</field>
            <field name="state">manual</field>
            <field name="readonly" eval="True"/>
        </record>
    </data>
</odoo>
