<?xml version="1.0" encoding="UTF-8"?>
<!-- Studio's tree view for res.groups (Access Groups list).
     CDB shipped this pair (view 4947 primary + view 4948 extension)
     because Odoo core doesn't ship a tree view for res.groups on this
     env; without them the Access Groups list falls back to Odoo's
     auto-generated tree with just display_name.
     4947 declares the primary <tree>; 4948 inherits it and appends
     id/create_uid/comment/create_date columns via xpath. -->
<odoo>
  <data>

    <record id="view_res_groups_tree_studio" model="ir.ui.view">
      <field name="name">res.groups.tree.studio</field>
      <field name="model">res.groups</field>
      <field name="type">tree</field>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <tree string="Access Groups">
          <field name="full_name" readonly="1"/>
        </tree>
      </field>
    </record>

    <record id="view_res_groups_tree_studio_ext" model="ir.ui.view">
      <field name="name">res.groups.tree.studio.ext</field>
      <field name="model">res.groups</field>
      <field name="type">tree</field>
      <field name="mode">extension</field>
      <field name="inherit_id" ref="view_res_groups_tree_studio"/>
      <field name="arch" type="xml">
        <data>
          <xpath expr="//field[@name='full_name']" position="before">
            <field name="id" optional="show"/>
          </xpath>
          <xpath expr="//field[@name='full_name']" position="after">
            <field name="create_uid" optional="show"/>
            <field name="comment" optional="show"/>
            <field name="create_date" optional="show"/>
          </xpath>
        </data>
      </field>
    </record>

  </data>
</odoo>
