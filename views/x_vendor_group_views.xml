<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- STRIPPED act_window_2677_x_customer_groups: model x_customer_groups not on target -->
<record id="act_window_1444_vendor_groups" model="ir.actions.act_window">
    <field name="name">Vendor Groups</field>
    <field name="res_model">x_vendor_group</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_3120_default_form_view_for_x_vendor_group_e" model="ir.ui.view">
      <field name="name">Default form view for x_vendor_group</field>
      <field name="model">x_vendor_group</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Vendor Group">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <span class="o_form_label">Group Code</span>
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_ac9527">
      <group name="studio_group_ac9527_left"/>
      <group name="studio_group_ac9527_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_3119_default_list_view_for_x_vendor_group_e" model="ir.ui.view">
      <field name="name">Default list view for x_vendor_group</field>
      <field name="model">x_vendor_group</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree>
      </field>
    </record>
    <record id="view_3121_default_search_view_for_x_vendor_group_e" model="ir.ui.view">
      <field name="name">Default search view for x_vendor_group</field>
      <field name="model">x_vendor_group</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archived" name="archived_x_vendor_group" domain="[['x_active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <!-- STRIPPED: x_studio_payment_method not on res.partner -->
<record id="view_final_x_vendor_group_odoo_studio_default_form_view_for_x_vendor_group_customizati" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for x_vendor_group customization</field>
      <field name="model">x_vendor_group</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="studio_usermodel_migration.view_3120_default_form_view_for_x_vendor_group_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//widget[@name='web_ribbon']" position="before">
    <div name="button_box" class="oe_button_box">
      <button class="oe_stat_button" icon="fa-sitemap" type="action" name="%(studio_usermodel_migration.act_window_1448_vendors)d" invisible="x_x_studio_vendor_group__res_partner_count == 0">
        <field widget="statinfo" name="x_x_studio_vendor_group__res_partner_count" string="Vendors"/>
      </button>
    </div>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="attributes">
    <attribute name="string">Code</attribute>
  </xpath>
  <xpath expr="//group[@name='studio_group_ac9527_left']" position="inside">
    <field name="x_studio_description" string="Description"/>
    <field name="x_studio_payment_term" string="Payment Term"/>
    <field name="x_studio_payable_account" string="Payable Account"/>
    <field name="x_studio_company_id"/>
  </xpath>
  <xpath expr="//group[@name='studio_group_ac9527']" position="after">
    <notebook name="studio_notebook_lED9i">
      <page string="Linked Vendors" name="studio_page_lED9i" invisible="x_x_studio_vendor_group__res_partner_count == 0">
        <field name="x_studio_one2many_field_5cEfV" string="Vendors">
          <tree string="Contacts" sample="1" multi_edit="1" create="false" edit="false" delete="false">
            <field name="name"/>
            <field name="property_supplier_payment_term_id"/>
            <field name="debit"/>
          </tree>
        </field>
      </page>
    </notebook>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_final_x_vendor_group_odoo_studio_default_list_view_for_x_vendor_group_customizati" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for x_vendor_group customization</field>
      <field name="model">x_vendor_group</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="studio_usermodel_migration.view_3119_default_list_view_for_x_vendor_group_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='x_studio_sequence']" position="attributes">
    <attribute name="column_invisible">1</attribute>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="after">
    <field name="x_studio_description"/>
    <field name="x_studio_payment_term" optional="show"/>
    <field name="x_studio_payable_account"/>
    <field optional="show" name="x_studio_company_id" string="Company"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
