<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="act_window_1443_customer_groups" model="ir.actions.act_window">
    <field name="name">Customer Groups</field>
    <field name="res_model">customer_group</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_3114_default_form_view_for_x_customer_group_e" model="ir.ui.view">
      <field name="name">Default form view for customer_group</field>
      <field name="model">customer_group</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Customer Group">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <span class="o_form_label">Group Code</span>
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_36e52f">
      <group name="studio_group_36e52f_left"/>
      <group name="studio_group_36e52f_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_3113_default_list_view_for_x_customer_group_e" model="ir.ui.view">
      <field name="name">Default list view for customer_group</field>
      <field name="model">customer_group</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_3115_default_search_view_for_x_customer_group_e" model="ir.ui.view">
      <field name="name">Default search view for customer_group</field>
      <field name="model">customer_group</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_customer_group" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_final_x_customer_group_odoo_studio_default_list_view_for_x_customer_group_customiza" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for customer_group customization</field>
      <field name="model">customer_group</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="studio_usermodel_migration.view_3113_default_list_view_for_x_customer_group_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='sequence']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
  <xpath expr="//field[@name='name']" position="after">
    <field name="description"/>
    <field name="payment_term"/>
    <field name="group_type"/>
    <field name="receivable_account"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
