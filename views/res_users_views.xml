<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_form_studio_ported" model="ir.ui.view">
        <field name="name">res.users.form.studio.ported</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='tz']" position="after">
                <field name="virtual_location" string="Virtual Location" options="{'no_create': True}" invisible="accounting_company_id and accounting_company_id != 1"/>
                <field name="virtual_location_1" string="Virtual Location" options="{'create_name_field': 'complete_name'}" invisible="accounting_company_id != 2"/>
                <field name="source_location" string="Source Location" options="{'no_create': True}" invisible="accounting_company_id and accounting_company_id != 1"/>
                <field name="source_location_1" string="Source Location" options="{'create_name_field': 'complete_name'}" invisible="accounting_company_id != 2"/>
                <field name="accounting_company_id" string="Current Company" invisible="1"/>
            </xpath>

            <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                <page string="Recruitment" name="studio_usermodel_recruitment">
                    <group>
                        <group>
                            <field name="recr_stages" widget="many2many_tags" string="Recruitment Stages"/>
                        </group>
                        <group/>
                    </group>
                </page>
                <page string="Manufacturing" name="studio_usermodel_manufacturing">
                    <group>
                        <group>
                            <field name="super_user_melt_items" string="Super User (Melt Items)"/>
                            <field name="super_user" string="Super User (All Items)" invisible="1"/>
                        </group>
                        <group/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
  <record id="view_res_users_form_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: res.users.form customization</field>
    <field name="model">res.users</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='action_open_employees']" position="after">
          
          
        </xpath>
        <xpath expr="//form[1]/sheet[1]/div[not(@name)][2]/group[1]/field[@name='partner_id']" position="attributes">
          <attribute name="invisible">(not id) or (id == False)</attribute><attribute name="readonly"/></xpath>
        <!---->
        <xpath expr="//field[@name='active']" position="attributes">
          <attribute name="invisible"/></xpath>
        <xpath expr="//field[@name='tz']" position="after">
          <field name="virtual_location" string="Virtual Location" options="{&quot;no_create&quot;:true}" invisible="accounting_company_id != 1"/>
          <field name="virtual_location_1" options="{'create_name_field': 'complete_name'}" string="Virtual Location" invisible="accounting_company_id != 2"/>
          <field name="source_location" string="Source Location" options="{&quot;no_create&quot;:true}" invisible="accounting_company_id != 1"/>
          <field name="source_location_1" options="{'create_name_field': 'complete_name'}" string="Source Location" invisible="accounting_company_id != 2"/>
          <field name="accounting_company_id" string="Current Company" invisible="1"/>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
          <page string="Recruitment" name="studio_page_AZpEI">
            <group name="studio_group_AZpEI">
              <group name="studio_group_AZpEI_left">
                <field name="recr_stages" string="Recruitment Stages" widget="many2many_tags" options="{&quot;color_field&quot;: &quot;color&quot;}"/>
              </group>
              <group name="studio_group_AZpEI_right"/>
            </group>
          </page>
          <page string="Manufacturing" name="studio_page_diV0C">
            <group name="studio_group_diV0C">
              <group name="studio_group_diV0C_left">
                <field name="super_user_melt_items" string="Super User (Melt Items)"/>
                <field name="super_user" string="Super User (All Items)" invisible="1"/>
              </group>
              <group name="studio_group_diV0C_right"/>
            </group>
          </page>
          <page string="Attendance Mgt." name="studio_page_AgKEb">
            <group name="studio_group_AgKEb">
              <group name="studio_group_AgKEb_left">
                <field name="attendance_administrator" string="Attendance Administrator"/>
              </group>
              <group name="studio_group_AgKEb_right"/>
            </group>
          </page>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
